# Qafila — keepalived (VRRP) : l'IP virtuelle suit le nœud dont Caddy répond.
# Généré par scripts/ha/node-setup.sh → /etc/keepalived/keepalived.conf
global_defs {
    router_id __ROUTER_ID__
    script_user root
    enable_script_security
}

vrrp_script chk_caddy {
    script "/usr/bin/curl -skf -o /dev/null --max-time 3 --resolve erp.qafila.tn:443:127.0.0.1 https://erp.qafila.tn/web/health"
    interval 5
    fall 2
    rise 2
    weight -60
}

vrrp_instance QAFILA_VIP {
    state __STATE__
    interface __IFACE__
    virtual_router_id 51
    priority __PRIORITY__
    advert_int 1
    unicast_src_ip __SELF_IP__
    unicast_peer {
        __PEER_IP__
    }
    authentication {
        auth_type PASS
        auth_pass __VRRP_PASSWORD__
    }
    virtual_ipaddress {
        __VIP__/24 dev __IFACE__
    }
    track_script {
        chk_caddy
    }
    # Quand ce nœud devient maître : si sa base est en secours, on la promeut en primaire.
    notify_master "__PROJECT_DIR__/scripts/ha/promote.sh"
}
