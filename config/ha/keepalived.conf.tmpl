# Qafila — keepalived (VRRP) : l'IP virtuelle est portée par UN nœud sain.
# Généré par scripts/ha/node-setup.sh → /etc/keepalived/keepalived.conf
#
# - Les deux nœuds démarrent en BACKUP avec « nopreempt » : un nœud qui revient après une panne
#   ne reprend PAS la VIP au nœud qui l'a remplacé (sinon : deux bases primaires, données perdues).
# - Le contrôle n'a pas de « weight » : s'il échoue, le nœud passe en FAULT et libère la VIP.
# - Les scripts sont dans /usr/libexec/keepalived/ (root, contexte SELinux prévu pour keepalived).
global_defs {
    router_id __ROUTER_ID__
    script_user root
    enable_script_security
}

vrrp_script chk_qafila {
    script "/usr/libexec/keepalived/qafila-check"
    interval 5
    timeout 8
    fall 2
    rise 2
}

vrrp_instance QAFILA_VIP {
    state BACKUP
    nopreempt
    interface __IFACE__
    virtual_router_id 51
    priority __PRIORITY__
    advert_int 1
    unicast_src_ip __SELF_IP__
    unicast_peer {
        __PEER_IP__
    }
    authentication {
        auth_type PASS
        auth_pass __VRRP_PASSWORD__
    }
    virtual_ipaddress {
        __VIP__/__PREFIX__ dev __IFACE__
    }
    track_script {
        chk_qafila
    }
    # Ce nœud devient maître : si sa base est une réplique, elle est promue en primaire.
    notify_master "/usr/libexec/keepalived/qafila-promote"
}
