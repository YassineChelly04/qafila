# Qafila — copiez ce fichier en .env et remplacez TOUTES les valeurs change-me.
# .env contient des secrets : il ne doit jamais être partagé ni committé.

# --- PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-db-password

# --- Odoo ---
ODOO_DB=qafila
ODOO_MASTER_PASSWORD=change-me-master-password
ODOO_ADMIN_EMAIL=yassine.chelly@qafila.tn
ODOO_ADMIN_PASSWORD=change-me-admin-password
ODOO_DEMO_USER_PASSWORD=change-me-demo-user-password

# --- Domaines locaux (résolus via /etc/hosts, aucun achat) ---
QAFILA_DOMAIN=qafila.tn
QAFILA_ERP_DOMAIN=erp.qafila.tn

# --- Haute disponibilité (nœuds clonés depuis le modèle) ---
NODE1_IP=192.168.56.11
NODE2_IP=192.168.56.12
VIP=192.168.56.10
VRRP_PASSWORD=change-me-vrrp
REPLICATION_PASSWORD=change-me-replication

# --- Sauvegardes (optionnel) : phrase de chiffrement GPG des dumps, durée de rétention ---
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14

# --- Rôle de cette machine : single (modèle, mono-hôte) | primary (nœud 1) | standby (nœud 2) ---
QAFILA_ROLE=single
